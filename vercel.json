{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "git fetch --unshallow || true; npm run build",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "career-ops.dev" }],
      "destination": "https://career-ops.org/:path*",
      "permanent": true
    },
    {
      "source": "/docs/introduction/guides/quick-start.mdx",
      "destination": "/docs",
      "permanent": true
    },
    {
      "source": "/docs/introduction/quick-start.mdx",
      "destination": "/docs",
      "permanent": true
    },
    {
      "source": "/docs/introduction/guides/quick-start",
      "destination": "/docs",
      "permanent": true
    },
    {
      "source": "/docs/quickstart",
      "destination": "/docs",
      "permanent": true
    },
    {
      "source": "/docs/quick-start",
      "destination": "/docs",
      "permanent": true
    },
    {
      "source": "/docs/getting-started",
      "destination": "/docs",
      "permanent": true
    },
    {
      "source": "/docs/getting-started/:path*",
      "destination": "/docs",
      "permanent": true
    },
    {
      "source": "/docs/installation",
      "destination": "/docs",
      "permanent": true
    },
    {
      "source": "/docs/install",
      "destination": "/docs",
      "permanent": true
    },
    {
      "source": "/docs/introduction/quick-start",
      "destination": "/docs",
      "permanent": true
    },
    {
      "source": "/docs/:path(.+)\\.mdx",
      "destination": "/docs/:path",
      "permanent": true
    },
    {
      "source": "/blog/can-an-ai-agent-run-your-whole-job-search",
      "destination": "/blog/can-an-ai-agent-run-your-job-search",
      "permanent": true
    },
    {
      "source": "/blog/what-740-listings-taught-me-about-the-ai-era-job-market",
      "destination": "/blog/job-search-data-from-740-listings",
      "permanent": true
    },
    {
      "source": "/blog/how-to-track-job-applications-with-a-tracker-you-own",
      "destination": "/blog/open-source-job-application-tracker",
      "permanent": true
    },
    {
      "source": "/blog/the-complete-guide-to-ai-powered-job-search-in-2026",
      "destination": "/blog/the-complete-ai-job-search-guide",
      "permanent": true
    },
    {
      "source": "/community",
      "destination": "https://discord.gg/8pRpHETxa4",
      "permanent": false
    },
    {
      "source": "/repo",
      "destination": "https://github.com/santifer/career-ops",
      "permanent": true
    },
    {
      "source": "/github",
      "destination": "https://github.com/santifer/career-ops",
      "permanent": true
    },
    {
      "source": "/career-ops",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/twitter",
      "destination": "https://x.com/santifer",
      "permanent": true
    },
    {
      "source": "/sponsors",
      "destination": "/sustain",
      "permanent": true
    },
    {
      "source": "/use-cases",
      "destination": "/docs/reference/modes",
      "permanent": true
    },
    {
      "source": "/use-cases/mode-:slug",
      "destination": "/docs/reference/modes/:slug",
      "permanent": true
    },
    {
      "source": "/use-cases/portal-:slug",
      "destination": "/docs/reference/portals/:slug",
      "permanent": true
    },
    {
      "source": "/use-cases/:path*",
      "destination": "/docs/reference/modes",
      "permanent": true
    },
    {
      "source": "/ai-job-search-tool",
      "destination": "/blog/the-complete-ai-job-search-guide",
      "permanent": true
    },
    {
      "source": "/job-application-tracker",
      "destination": "/docs/reference/modes/tracker",
      "permanent": true
    },
    {
      "source": "/claude-code-job-search",
      "destination": "/blog/why-career-ops",
      "permanent": true
    },
    {
      "source": "/ats-optimized-resume",
      "destination": "/docs/reference/modes/pdf",
      "permanent": true
    },
    {
      "source": "/local-first-job-search",
      "destination": "/blog/why-career-ops",
      "permanent": true
    }
  ]
}
